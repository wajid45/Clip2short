// ClipFlow data model.
// SQLite for local development; switch `provider` to "postgresql" for production
// (all types used here are portable between the two).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Billing (Stripe)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  plan                 String    @default("none") // none | creator | pro | studio
  subscriptionStatus   String    @default("none") // none | trialing | active | past_due | canceled | incomplete | unpaid
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)

  // Credits: free trial is granted once; plans grant monthly credits; packs add more.
  trialStartedAt DateTime?

  videos             Video[]
  clips              Clip[]
  socialAccounts     SocialAccount[]
  posts              Post[]
  usage              UsageEvent[]
  creditGrants       CreditGrant[]
  creditTransactions CreditTransaction[]
}

/// A batch of credits from one source. Spending draws from the soonest-expiring grants first.
model CreditGrant {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    String // trial | plan | pack | admin
  amount    Int
  remaining Int
  expiresAt DateTime?
  ref       String?   @unique // Stripe invoice / checkout session id, for idempotency
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

/// Append-only history of every credit movement shown to the user.
model CreditTransaction {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta       Int // positive = added, negative = spent
  kind        String // grant | spend | refund
  description String
  videoId     String?
  allocJson   String? // spend: [{grantId, amount}] so a refund returns credits to the same grants
  refundedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

model Video {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceUrl   String
  platform    String // youtube | vimeo | direct
  externalId  String?
  title       String
  description String   @default("")
  author      String?
  durationSec Float?
  thumbnailUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Captions / transcript
  captionStatus    String  @default("pending") // pending | ready | missing | failed
  captionSource    String? // e.g. "youtube:manual:en", "youtube:asr:en", "youtube:translated:en", "vimeo:texttrack:en", "agent:fetch", "paste:timed", "paste:plain"
  captionTiming    String? // exact | estimated
  captionLanguage  String?
  captionNote      String? // human-readable explanation of how captions were obtained / why they failed
  transcriptJson   String? // JSON: Array<{ start: number; end: number; text: string }>

  // AI analysis
  analysisStatus String    @default("idle") // idle | running | done | failed
  analysisCount  Int       @default(0) // completed analyses; the first costs full credits, re-runs less
  analysisFocus  String    @default("auto") // auto | events | funny | insights
  analysisError  String?
  analyzedAt     DateTime?
  summary        String?

  clips Clip[]

  @@index([userId, createdAt])
}

model Clip {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title    String
  startSec Float
  endSec   Float
  status   String  @default("idea") // idea | draft | ready | published
  origin   String  @default("ai") // ai | manual
  category String? // insight | story | humor | hot-take | how-to | emotional | data | quote

  score       Int? // 0-100 virality score
  scoreHook   Int?
  scoreSelf   Int? // self-containment
  scorePayoff Int?
  scoreQuote  Int? // quotability
  reason      String? // why the AI picked it
  hook        String  @default("")
  caption     String  @default("")
  hashtags    String  @default("")
  notes       String  @default("")
  transcript  String  @default("") // excerpt covering the clip
  suggestionsJson String? // latest AI posting suggestions, awaiting the user's approval

  posts Post[]

  @@index([userId, score])
  @@index([videoId])
}

model SocialAccount {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform          String // instagram | threads | facebook | tiktok | x | sandbox
  externalId        String
  displayName       String
  username          String?
  avatarUrl         String?
  accessTokenEnc    String
  refreshTokenEnc   String?
  tokenExpiresAt    DateTime?
  metaJson          String? // provider extras (e.g. page id for IG business, scopes)
  status            String    @default("active") // active | expired | revoked
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  posts Post[]

  @@unique([userId, platform, externalId])
}

model Post {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clipId      String
  clip        Clip      @relation(fields: [clipId], references: [id], onDelete: Cascade)
  accountId   String?
  account     SocialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountName String    @default("")
  platform    String
  text        String
  status      String    @default("queued") // uploading | queued | scheduled | publishing | published | failed | canceled
  scheduledAt DateTime?
  publishedAt DateTime?
  attempts    Int       @default(0)
  externalId  String?
  liveUrl     String?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // YouTube uploads: resumable session (server-side only) and requested visibility
  uploadUrl   String?
  uploadSize  Int?
  privacy     String? // public | unlisted | private

  // Live post stats (refreshed from platform APIs)
  views         Int?
  likes         Int?
  comments      Int?
  shares        Int?
  statsUpdatedAt DateTime?

  @@index([status, scheduledAt])
  @@index([userId, createdAt])
}

model OAuthState {
  id        String   @id // random state value
  userId    String
  platform  String
  verifier  String? // PKCE code verifier
  popup     Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// Developer-app credentials entered by an admin in the app (override environment variables).
model IntegrationSetting {
  id              String   @id // meta | threads | tiktok | x | google
  clientId        String
  clientSecretEnc String?
  updatedAt       DateTime @updatedAt
}

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // video_import | ai_analysis
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
}

model Lead {
  id          String   @id @default(cuid())
  email       String   @unique
  source      String   @default("landing-hero")
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  referrer    String?
  userAgent   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  signups     Int      @default(1)
}

model ProcessedWebhook {
  id        String   @id // Stripe event id, for idempotency
  createdAt DateTime @default(now())
}
