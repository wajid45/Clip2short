{
  "name": "@shortlark/server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Shortlark API: Express + Prisma. Auth, credits, Stripe, AI analysis, video cutting, social publishing.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "prisma generate && node build.mjs",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@prisma/client": "^6",
    "@shortlark/shared": "*",
    "bcryptjs": "^3.0.3",
    "cors": "2.8.5",
    "express": "5.1.0",
    "ffmpeg-static": "^5.3.0",
    "jose": "^6.2.17",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "^20",
    "esbuild": "0.25.5",
    "prisma": "^6",
    "tsx": "4.20.3"
  }
}
