# Web app URL: sign-up, sign-in and plan buttons link here.
VITE_APP_URL="http://localhost:3000"
# API origin for the lead form. Leave empty in development (Vite proxies /api);
# in production set it to the web app/API origin, e.g. https://app.shortlark.com
VITE_API_URL=""
# Optional: Plausible analytics domain (e.g. shortlark.com). Empty = no analytics.
VITE_PLAUSIBLE_DOMAIN=""
# Build-time only (read by prerender.mjs): the public origin, used for canonical links and the sitemap.
SITE_URL="https://shortlark.com"
