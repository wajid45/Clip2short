# ─── Core ────────────────────────────────────────────────────────────────
# Empty = SQLite at backend/data/dev.db. Production: a Postgres URL, e.g. postgresql+psycopg://user:pass@host/shortlark
DATABASE_URL=""
# Public URL of the web app. The API is served from the same origin (Vite proxies /api in
# development; in production this server also serves web/dist). Used for OAuth redirects and Stripe returns.
APP_URL="http://localhost:3000"
# Public URL of the landing site; the only other origin allowed to call the API (lead capture).
LANDING_URL="http://localhost:3001"
# Port the API listens on.
PORT=4000
# Set to "true" behind a reverse proxy / load balancer so client IPs and https are detected.
# TRUST_PROXY="true"
# Where the built web app lives (defaults to ../web/dist).
# WEB_DIST="/srv/shortlark/web/dist"
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=""
ENCRYPTION_KEY=""   # encrypts social tokens at rest; don't change after accounts are connected
CRON_SECRET=""      # external cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/publish
ADMIN_EMAILS=""     # comma-separated; these users can sign in to the admin portal (and see /admin/* in the app)
PASSWORD_BREACH_CHECK=""   # "false" turns off the breached-password check (Have I Been Pwned, k-anonymity); on by default
ADMIN_ALLOWED_IPS="" # optional: comma-separated IPs allowed to call the admin portal API; empty = any
# ADMIN_URL="http://localhost:3002"  # the admin portal's origin

# ─── AI (Google Gemini) ──────────────────────────────────────────────────
# Create a key at https://aistudio.google.com/apikey (a free tier is available).
GEMINI_API_KEY=""
# Model id from https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL="gemini-3.8-flash"
# One model per video category (the user picks the category when importing). Empty = GEMINI_MODEL.
# GEMINI_MODEL_PODCAST=""
# GEMINI_MODEL_GAMING=""
# GEMINI_MODEL_MOVIES=""
# GEMINI_MODEL_SPORTS=""
# GEMINI_MODEL_OTHER=""

# ─── Email (Resend) ──────────────────────────────────────────────────────
# Sends password-reset emails. Create a key at https://resend.com and verify your domain.
# Without a key, local development prints reset links to the API log instead.
RESEND_API_KEY=""
EMAIL_FROM="Shortlark <no-reply@shortlark.com>"

# ─── Billing (Stripe) ────────────────────────────────────────────────────
# Create three monthly recurring prices in Stripe and paste their price ids.
# Credit packs need no Stripe setup (priced inline at checkout).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_CREATOR=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_STUDIO=""
# Free trial credits, plan credits and pack prices are set in src/lib/plans.ts

# ─── Social networks ─────────────────────────────────────────────────────
# Easiest: leave these blank and enter them in the app under Admin → Integrations
# (stored encrypted; values saved there override these).
# Redirect URI for every provider: {APP_URL}/api/social/callback/{platform}
#   platform = youtube | facebook | instagram
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
META_APP_ID=""
META_APP_SECRET=""

# Sandbox accounts simulate publishing. On by default in development, off in production.
# SOCIAL_SANDBOX="false"
# The 15-minute publisher runs inside the API process by default. Set to "false" if an external
# cron calls /api/cron/publish instead (e.g. when running several API instances).
# INTERNAL_SCHEDULER="false"
